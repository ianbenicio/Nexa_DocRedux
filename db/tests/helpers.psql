-- Funções de apoio dos testes (schema tests, criado e descartado dentro da transação de cada arquivo).
-- Incluído por \ir no início de cada arquivo de teste.

create extension if not exists pgtap with schema extensions;
create schema if not exists tests;

-- Usuário do Auth (dispara private.novo_usuario: perfil + concessão inicial).
create or replace function tests.novo_usuario(p_email text) returns uuid
language plpgsql as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, email, aud, role) values (v_id, p_email, 'authenticated', 'authenticated');
  return v_id;
end
$$;

-- Documento com status e orçamento. Status `recusado` exige motivo.
create or replace function tests.novo_documento(
  p_usuario uuid, p_status public.status_documento default 'aguardando_upload',
  p_total integer default null, p_motivo public.motivo_recusa default null
) returns uuid
language plpgsql as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into public.documentos (id, usuario_id, idempotency_key, nome_arquivo, tamanho_bytes, status,
                                 motivo_recusa, orcamento)
  values (v_id, p_usuario, v_id::text, 'teste.pdf', 1000, p_status, p_motivo,
          case when p_total is not null then jsonb_build_object('total', p_total) end);
  return v_id;
end
$$;

-- Entrega versão p_versao; p_atual = aponta documentos.entrega_atual para ela.
create or replace function tests.nova_entrega(
  p_documento uuid, p_versao integer default 1, p_atual boolean default true,
  p_gate public.gate_cobertura default 'ok', p_criado_em timestamptz default now()
) returns void
language plpgsql as $$
begin
  insert into public.entregas (documento_id, versao, caminho_pdf, relatorio, cobertura, paginas_depois, gate, criado_em)
  values (p_documento, p_versao, format('u/%s/v%s/saida.pdf', p_documento, p_versao), '{}', 0.999, 3, p_gate, p_criado_em);
  if p_atual then
    update public.documentos set entrega_atual = p_versao where id = p_documento;
  end if;
end
$$;

-- Age como um usuário autenticado (RLS) ou como anon.
create or replace function tests.como(p_usuario uuid) returns void
language plpgsql as $$
begin
  if p_usuario is null then
    perform set_config('request.jwt.claims', '{"role":"anon"}', true);
    execute 'set local role anon';
  else
    perform set_config('request.jwt.claims',
      json_build_object('sub', p_usuario, 'role', 'authenticated')::text, true);
    execute 'set local role authenticated';
  end if;
end
$$;

grant usage on schema tests to anon, authenticated, docredux_backend;
grant execute on all functions in schema tests to anon, authenticated, docredux_backend;
grant usage on schema extensions to docredux_backend;  -- pgTAP sob o papel do backend; some no rollback
