# Worker de produção (Oracle A1, unidade 7). Copie para deploy/.env (gitignored) e preencha no servidor.
# Nada aqui é valor real. Em dev, `python api/scripts/dev_setup.py` gera deploy/.env.dev sozinho.

# Banco: papel docredux_backend (nunca postgres/service_role), modo sessão do pooler (porta 5432):
# o worker segura transações com FOR UPDATE SKIP LOCKED e advisory locks.
DATABASE_URL=postgresql://docredux_backend.<ref>:<senha>@<pooler>.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
# Chave secreta do projeto (sb_secret_...): Storage e Auth admin. Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=
WEB_URL=https://<dominio>

# Avisos por e-mail (story 4.7). Vazio = desligado. Conta Resend e domínio: responsável + @devops.
RESEND_API_KEY=
RESEND_FROM=DocRedux <avisos@<dominio>>

# Worker (spec §7)
WORKER_PROCESSOS=2
WORKER_TIPOS=triagem,processar
WORKER_TIMEOUT_TRIAGEM_S=300
WORKER_TIMEOUT_PROCESSAR_S=900
