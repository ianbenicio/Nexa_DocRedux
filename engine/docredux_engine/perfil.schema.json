{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/ianbenicio/Nexa_DocRedux/engine/docredux_engine/perfil.schema.json",
 "title": "Perfil de template do DocRedux",
 "description": "Derivado de engine/perfis/*.json (mathema-saeb, mec-sase-relatorio) e dos campos lidos pelo motor. Cores aceitam '#RRGGBB' (JSON) ou inteiro (perfil já carregado por load_perfil).",
 "type": "object",
 "required": ["nome", "tipo", "assinatura"],
 "properties": {
  "nome": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
  "tipo": {"enum": ["ficha", "relatorio"]},
  "assinatura": {
   "type": "object", "required": ["fontes_contem"],
   "properties": {"fontes_contem": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}}
  },
  "regras_desligadas": {"type": "array", "items": {"type": "string", "pattern": "^(R\\d{1,3}|RE_Q)$"}},
  "img_dpi": {"type": "integer", "minimum": 72, "maximum": 300},
  "cor_destaque": {"$ref": "#/$defs/cor"},
  "cores_marcador": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cor"}},
  "titulo_aula": {"type": "object", "required": ["font_contains", "size", "color"],
   "properties": {"font_contains": {"type": "string"}, "size": {"type": "number"}, "color": {"$ref": "#/$defs/cor"}}},
  "tag_aula": {"type": "object", "required": ["regex"],
   "properties": {"regex": {"$ref": "#/$defs/regex"}, "color": {"$ref": "#/$defs/cor"}}},
  "secao": {"type": "object", "properties": {"font_contains": {"type": "string"}, "size_min": {"type": "number"}, "size_max": {"type": "number"}}},
  "fonte_ref_size": {"type": "number", "exclusiveMinimum": 0},
  "running_header_regex": {"$ref": "#/$defs/regex"},
  "rodape_regex": {"$ref": "#/$defs/regex"},
  "pagina_pt": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
  "faixa_topo_y": {"type": "number", "minimum": 0},
  "faixa_rodape_y": {"type": "number", "minimum": 0},
  "recuo_primeira_linha": {"type": "number", "minimum": 0},
  "margem_esq_par": {"type": "number", "minimum": 0},
  "margem_esq_impar": {"type": "number", "minimum": 0},
  "h1": {"type": "object", "required": ["size_min"], "properties": {"size_min": {"type": "number"}}},
  "h2": {"type": "object", "required": ["textos", "cambria_bold_size"],
   "properties": {"textos": {"type": "array", "items": {"type": "string"}}, "faixa_cinza": {"type": "boolean"}, "cambria_bold_size": {"type": "number"}}},
  "h3": {"type": "object", "required": ["size"], "properties": {"font_contains": {"type": "string"}, "size": {"type": "number"}}},
  "h4": {"type": "object", "properties": {"font_contains": {"type": "string"}, "size_max": {"type": "number"}, "font_italico": {"type": "string"}}},
  "corpo": {"type": "object", "properties": {"size_min": {"type": "number"}, "size_max": {"type": "number"}}},
  "citacao": {"type": "object", "required": ["size_min", "size_max", "recuo_min"],
   "properties": {"size_min": {"type": "number"}, "size_max": {"type": "number"}, "recuo_min": {"type": "number"}}},
  "referencia": {"type": "object", "required": ["secao", "size_max", "gap_nova_entrada"],
   "properties": {"secao": {"type": "string"}, "size_max": {"type": "number"}, "gap_nova_entrada": {"type": "number"}}},
  "nota_rodape": {"type": "object", "required": ["size_numero_max"], "properties": {"size_numero_max": {"type": "number"}}},
  "legenda_regex": {"$ref": "#/$defs/regex"},
  "fonte_regex": {"$ref": "#/$defs/regex"},
  "capitulo_regex": {"$ref": "#/$defs/regex"},
  "secoes_h1": {"type": "object", "additionalProperties": {"type": "string"}},
  "foto_pagina_inteira_min_pct": {"type": "number", "minimum": 0, "maximum": 100},
  "pagina_vazia_max_palavras": {"type": "integer", "minimum": 0}
 },
 "allOf": [
  {"if": {"properties": {"tipo": {"const": "ficha"}}},
   "then": {"required": ["cor_destaque", "cores_marcador", "titulo_aula", "tag_aula", "secao", "fonte_ref_size", "running_header_regex", "rodape_regex"]}},
  {"if": {"properties": {"tipo": {"const": "relatorio"}}},
   "then": {"required": ["pagina_pt", "faixa_topo_y", "faixa_rodape_y", "recuo_primeira_linha", "margem_esq_par", "margem_esq_impar", "h1", "h2", "h3", "h4", "corpo", "citacao", "referencia", "nota_rodape", "legenda_regex", "fonte_regex", "capitulo_regex", "secoes_h1", "foto_pagina_inteira_min_pct", "pagina_vazia_max_palavras"]}}
 ],
 "$defs": {
  "cor": {"type": ["string", "integer"], "pattern": "^#[0-9A-Fa-f]{6}$", "minimum": 0, "maximum": 16777215},
  "regex": {"type": "string", "minLength": 1, "format": "regex"}
 }
}
